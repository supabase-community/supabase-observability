# -- Logs -------------------------------
# Absolute path to your Supabase docker/ directory (the folder
# containing Supabase's own docker-compose.yml). Used by
# scripts/set-log-levels.sh and scripts/verify-logs.sh.
SUPABASE_DIR=

# Label attached to every log stream.
ENVIRONMENT=dev

# Log store endpoints. VictoriaLogs is the default sink;
# Loki is the documented alternative (backends/).
VICTORIALOGS_ENDPOINT=http://victorialogs:9428
LOKI_ENDPOINT=http://loki:3100

# Retention for the default log store.
LOGS_RETENTION_PERIOD=30d

# Which log backend runs. Must match a file in backends/
# named vector/<value>.yaml - currently: loki, victorialogs.
# COMPOSE_PROFILES must match this value so the right store
# container actually starts (docker-compose.o11y-logs.yml uses
# profiles: ["loki"] / ["victorialogs"]).
BACKEND_LOGS=victorialogs
COMPOSE_PROFILES=${BACKEND_LOGS}

# Per-service log verbosity. Leave a line commented out to keep that
# service's upstream default. Apply with:
#   scripts/set-log-levels.sh apply
# Revert everything with:
#   scripts/set-log-levels.sh reset
# All of these require restarting the affected container.
# rest/realtime/storage/envoy/kong are case-sensitive: use lowercase exactly
# as shown in overrides/log-levels.yml.

#SUPABASE_REST_LOG_LEVEL=
#SUPABASE_AUTH_LOG_LEVEL=       # WARNING: debug logs the OAuth exchange code in full
#SUPABASE_REALTIME_LOG_LEVEL=   # WARNING: debug logs plaintext tenant JWT secret on create/update
#SUPABASE_STORAGE_LOG_LEVEL=
#SUPABASE_FUNCTIONS_LOG_LEVEL=
#SUPABASE_ENVOY_LOG_LEVEL=      # gateway; "warning" and "warn" both work
#SUPABASE_KONG_LOG_LEVEL=       # only if you run Kong
#SUPABASE_DB_LOG_LEVEL=
