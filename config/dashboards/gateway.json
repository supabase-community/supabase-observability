{
  "uid": "supabase-gateway",
  "title": "API Gateway",
  "description": "Requests, errors, response speed and traffic through the Envoy gateway, laid out like Supabase Studio's API Gateway report.",
  "tags": [
    "supabase"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1m",
      "5m",
      "15m"
    ]
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "link",
      "title": "Overview",
      "url": "/d/supabase-overview",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false,
      "asDropdown": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "API Gateway",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Total Requests",
      "description": "Every request the gateway answered, including requests it rejected itself (for example a missing or wrong API key) and requests to Studio and pg-meta. The chart shows the rate per second, and the legend shows the total for the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(envoy_http_downstream_rq_total{envoy_http_conn_manager_prefix=\"ingress_http\"}[$__rate_interval]))",
          "legendFormat": "Requests",
          "instant": false,
          "range": true
        },
        {
          "refId": "TA",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(envoy_http_downstream_rq_total{envoy_http_conn_manager_prefix=\"ingress_http\"}[$__range]))",
          "legendFormat": "Requests",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No requests",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "Per second"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": false,
                  "viz": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "TA"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": true,
                  "viz": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Response Errors",
      "description": "Responses with a 4xx or 5xx status code, including the 401 and 403 responses the gateway returns itself when an API key is missing or wrong. The chart shows the rate per second, and the legend shows the total for the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (envoy_response_code_class) (rate(envoy_http_downstream_rq_xx_total{envoy_http_conn_manager_prefix=\"ingress_http\",envoy_response_code_class=~\"4|5\"}[$__rate_interval])) > 0",
          "legendFormat": "{{envoy_response_code_class}}xx",
          "instant": false,
          "range": true
        },
        {
          "refId": "TA",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (envoy_response_code_class) (increase(envoy_http_downstream_rq_xx_total{envoy_http_conn_manager_prefix=\"ingress_http\",envoy_response_code_class=~\"4|5\"}[$__range])) > 0",
          "legendFormat": "{{envoy_response_code_class}}xx",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No errors",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "Per second"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": false,
                  "viz": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "TA"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": true,
                  "viz": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Response Speed",
      "description": "Time from the gateway sending a request to a service until the service's response is complete, in milliseconds. Average is the measure Studio shows, and p95 is the 95th percentile. Realtime's response time covers only its HTTP API requests, because Envoy records no response time for WebSocket connections. Requests the gateway rejected itself are left out because they never reach a service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(envoy_cluster_upstream_rq_time_sum{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\"}[$__rate_interval])) / sum(rate(envoy_cluster_upstream_rq_time_count{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\"}[$__rate_interval]))",
          "legendFormat": "Average",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(envoy_cluster_upstream_rq_time_bucket{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "noValue": "No requests",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Network Traffic",
      "description": "Bytes between the gateway and PostgREST, Auth, Edge Functions, Storage and Realtime. Ingress is what the gateway sent to the services, which is the requests. Egress is what the services sent back, which is the responses. Both count headers as well as bodies. The chart shows the rate per second, and the legend shows the total for the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(envoy_cluster_upstream_cx_tx_bytes_total{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\"}[$__rate_interval]))",
          "legendFormat": "Ingress",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(envoy_cluster_upstream_cx_rx_bytes_total{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\"}[$__rate_interval]))",
          "legendFormat": "Egress",
          "instant": false,
          "range": true
        },
        {
          "refId": "TA",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(envoy_cluster_upstream_cx_tx_bytes_total{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\"}[$__range]))",
          "legendFormat": "Ingress",
          "instant": true,
          "range": false
        },
        {
          "refId": "TB",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(envoy_cluster_upstream_cx_rx_bytes_total{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\"}[$__range]))",
          "legendFormat": "Egress",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "decimals": 1,
          "noValue": "No requests",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "Per second"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "(^| )[Ee]gress$"
            },
            "properties": [
              {
                "id": "custom.transform",
                "value": "negative-Y"
              },
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "normal",
                  "group": "B"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": false,
                  "viz": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": false,
                  "viz": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "TA"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": true,
                  "viz": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "TB"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": true,
                  "viz": true
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ingress"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Egress"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 6,
      "title": "By service",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Total Requests by service",
      "description": "Requests that reached each service through the gateway. Requests the gateway rejected itself are not counted here. The chart shows the rate per second, and the legend shows the total for the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^rest(.*)$",
            "renamePattern": "PostgREST$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^auth(.*)$",
            "renamePattern": "Auth$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^functions(.*)$",
            "renamePattern": "Edge Functions$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^storage(.*)$",
            "renamePattern": "Storage$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^realtime(.*)$",
            "renamePattern": "Realtime$1"
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\",envoy_response_code=\"\"}[$__rate_interval])) > 0",
          "legendFormat": "{{envoy_cluster_name}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "TA",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (envoy_cluster_name) (increase(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\",envoy_response_code=\"\"}[$__range])) > 0",
          "legendFormat": "{{envoy_cluster_name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No requests",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "Per second"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^PostgREST( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Auth( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Edge Functions( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Storage( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Realtime( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": false,
                  "viz": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "TA"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": false,
                  "tooltip": true,
                  "viz": true
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Response Errors by service",
      "description": "Responses with a 4xx or 5xx status code from each service. The 401 and 403 responses the gateway returns itself are only in Response Errors above. The chart shows the rate per second, and the legend shows the total for the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^rest(.*)$",
            "renamePattern": "PostgREST$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^auth(.*)$",
            "renamePattern": "Auth$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^functions(.*)$",
            "renamePattern": "Edge Functions$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^storage(.*)$",
            "renamePattern": "Storage$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^realtime(.*)$",
            "renamePattern": "Realtime$1"
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_xx_total{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\",envoy_response_code_class=~\"4|5\"}[$__rate_interval])) > 0",
          "legendFormat": "{{envoy_cluster_name}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "TA",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (envoy_cluster_name) (increase(envoy_cluster_upstream_rq_xx_total{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\",envoy_response_code_class=~\"4|5\"}[$__range])) > 0",
          "legendFormat": "{{envoy_cluster_name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No errors",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never",
            "axisLabel": "Per second"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^PostgREST( .*)?$"
            },
            "properties": [
              {
