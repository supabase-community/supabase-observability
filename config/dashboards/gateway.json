        "w": 12,
        "x": 0,
        "y": 18
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^rest(.*)$",
            "renamePattern": "PostgREST$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^auth(.*)$",
            "renamePattern": "Auth$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^functions(.*)$",
            "renamePattern": "Edge Functions$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^storage(.*)$",
            "renamePattern": "Storage$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^realtime(.*)$",
            "renamePattern": "Realtime$1"
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (envoy_cluster_name) (increase(envoy_cluster_upstream_rq_total{envoy_cluster_name=~\"rest|auth|functions|storage|realtime\",envoy_response_code=\"\"}[$__interval])) > 0",
          "legendFormat": "{{envoy_cluster_name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No requests",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^PostgREST( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Auth( .*)?$"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
