    {
      "type": "timeseries",
      "id": 10,
      "title": "Network Traffic by service",
      "description": "Bytes between the gateway and each service. Ingress, above the axis, is the requests sent to the service. Egress, below the axis, is the responses it sent back. Both count headers as well as bodies. The legend shows the total for the selected time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^rest(.*)$",
            "renamePattern": "PostgREST$1"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
