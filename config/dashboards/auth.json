    {
      "type": "timeseries",
      "id": 14,
      "title": "Response Speed",
      "description": "Time from the gateway sending a request to Auth until Auth's response is complete, in milliseconds. Average is the measure Studio shows, and p95 is the 95th percentile. Requests the gateway rejected itself are left out because they never reach Auth.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "2m",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(envoy_cluster_upstream_rq_time_sum{envoy_cluster_name=\"auth\"}[$__rate_interval])) / sum(rate(envoy_cluster_upstream_rq_time_count{envoy_cluster_name=\"auth\"}[$__rate_interval]))",
          "legendFormat": "Average",
          "instant": false,
